{
  "name": "matter-of-place",
  "private": true,
  "version": "0.1.0",
  "description": "Matter of Place: a selective property publication. Frontend, content model and API contracts.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "bun": "1.3.13",
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint . --max-warnings 0 && cd .. && eslint --config app/eslint.config.js --max-warnings 0 workspace/05-plans/merge-gate.mjs workspace/audits/tools scripts/audit",
    "lint:fix": "eslint . --fix --max-warnings 0 && cd .. && eslint --config app/eslint.config.js --fix --max-warnings 0 workspace/05-plans/merge-gate.mjs workspace/audits/tools scripts/audit",
    "format": "prettier --config .prettierrc --write . ../workspace/05-plans/merge-gate.mjs ../workspace/audits/tools ../scripts/audit",
    "format:check": "prettier --config .prettierrc --check . ../workspace/05-plans/merge-gate.mjs ../workspace/audits/tools ../scripts/audit",
    "test": "vitest run --project unit --project component --maxWorkers=2 --testTimeout=60000 --hookTimeout=60000",
    "check": "bun run layout && bun run typecheck && bun run lint && bun run knip && bun run jscpd && bun run stubs && bun run format:check && bun run test",
    "knip": "knip",
    "jscpd": "jscpd",
    "stubs": "bun run scripts/stubs.ts",
    "layout": "node scripts/check-layout.mjs",
    "migrations:check": "node scripts/check-migrations.mjs",
    "db:push": "bun scripts/db-push.mjs",
    "db:fn": "bun scripts/db-fn.mjs",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test --project=desktop --project=phone",
    "test:e2e:live": "playwright test --project=live-desktop",
    "test:e2e:edge": "playwright test --project=edge",
    "test:e2e:coming-soon": "bun scripts/e2e-coming-soon.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "watchfail": "node scripts/watchfail.mjs",
    "db:reset": "bun scripts/db-reset-dev.mjs",
    "db:psql": "bun scripts/psql-dev.mjs",
    "db:lint": "supabase db lint --linked --level warning",
    "gen:types": "bun scripts/gen-types.mjs",
    "seed": "bun --preload ./scripts/lib/asset-loader.ts scripts/seed.ts",
    "fixtures:load": "bun scripts/load-fixtures.ts",
    "set-env": "bun scripts/set-environment.ts",
    "cpu-gate": "node scripts/cpu-gate.mjs",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "variants": "bun scripts/variants.ts",
    "fonts": "node scripts/fonts.mjs",
    "captions": "bun scripts/captions-runner.ts",
    "omnikom:mock": "bun run scripts/omnikom-mock.ts",
    "omnikom:run-local": "bun run scripts/omnikom-run-local.ts",
    "cf:preview": "cp .dev.vars .output/server/.dev.vars && wrangler dev --config .output/server/wrangler.json --port 8788"
  },
  "trustedDependencies": [
    "supabase",
    "sharp"
  ],
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "cron-parser": "5.10.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.32.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/epilogue": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.13.0",
    "heic-convert": "^2.1.0",
    "jscpd": "^5.4.0",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "nitro": "3.0.260603-beta",
    "pg": "^8.23.1",
    "prettier": "^3.7.3",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "supabase": "^2.119.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5",
    "vitest": "^5.0.2",
    "wrangler": "4.145.0",
    "yaml": "^2.9.1"
  }
}
