# Public build-time settings. Everything here ships to the browser; never put secrets in VITE_* variables.

# Absolute origin of the deployed site, used for canonical URLs and structured data.
VITE_SITE_URL=https://matterofplace.com

# Base URL of the Matter of Place API. Leave unset to run from bundled content with local, non-persistent forms.
# VITE_API_BASE_URL=https://matterofplace.com/api

# Public Instagram profile. The footer link appears only when this is set.
# VITE_INSTAGRAM_URL=https://www.instagram.com/matterofplace
