# Public build-time settings. Everything in this first block ships to the browser; never put secrets in VITE_* variables.
# Server names further down are read by Wrangler and Nitro, never by Vite.

# Absolute origin of the deployed site, used for canonical URLs and structured data.
VITE_SITE_URL=https://matterofplace.com

# Base URL of the Matter of Place API: /api/public in every deployed build (same origin). Leave unset to run from bundled
# content with local, non-persistent forms. On Git Bash a value starting with a slash needs MSYS_NO_PATHCONV=1.
# VITE_API_BASE_URL=/api/public

# Public Cloudflare Turnstile site key (public by design; the secret key never leaves the server).
VITE_TURNSTILE_SITE_KEY=

# Public Instagram profile. The footer link appears only when this is set.
# VITE_INSTAGRAM_URL=https://www.instagram.com/matterofplace

# Database tools on the laptop (bun run db:psql, bun run db:reset). Server side only: names, never values here.
# Session pooler URL of mop-dev, password percent-encoded:
# postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DEV_DB_URL=
DEV_SUPABASE_PROJECT_REF=
DEV_SUPABASE_DB_PASSWORD=
DEV_SUPABASE_SERVICE_ROLE_KEY=

# Worker settings. Server side only: names, never values here. Locally they go in app/.dev.vars (git-ignored); deployed,
# the deploy jobs and wrangler.toml set them (docs/runbooks/delivery.md).
# local, preview or production: decides which content and which indexing rules apply.
MOP_ENV=
# Absolute base of the public media bucket, the Worker's own origin plus /media.
MEDIA_PUBLIC_BASE=
# Project URL and service role key of the one Supabase project. Required when MOP_ENV is production; the key never goes
# in a VITE_* name and never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Turnstile secret key. Required unless MOP_ENV is local; previews use Cloudflare's always-pass test secret, production
# the real one (docs/runbooks/api.md).
TURNSTILE_SECRET=
# Salt of the hashed IP address in rate limits and rows. Required in every environment.
RATE_LIMIT_SALT=
# Svix signing secret of the Resend webhook. Optional until the orchestrator adds it to the Worker secrets.
RESEND_WEBHOOK_SECRET=
# Milliseconds a Worker isolate trusts its catalog version. Optional; 15000 when unset.
CATALOG_VERSION_TTL_MS=
# Sentry client key of the Worker (a Worker secret). Leave empty to send nothing.
SENTRY_DSN=
# Bearer for POST /api/hooks/sentry-test (a Worker secret). Leave empty and the route answers 404.
SENTRY_TEST_TOKEN=
# Commit SHA of the deploy, set by the deploy jobs with --var; reads as dev when unset.
SENTRY_RELEASE=

# Job runner (B8). Server side only: names, never values here. The Edge Function reads them from Supabase function
# secrets; the Worker also holds JOB_RUNNER_SECRET, OPS_HEALTH_TOKEN and RENDER_CALLBACK_SECRET.
# Bearer the cron sends to the job runner; the Worker never reads it.
JOB_RUNNER_SECRET=
# Path token of GET /api/hooks/ops-health/<token>. Leave empty and the route answers 404.
OPS_HEALTH_TOKEN=
# Fine-grained GitHub token for this repository only: Actions read and write, Metadata read, no Contents.
GITHUB_DISPATCH_TOKEN=
# owner/name of the repository whose render.yml runs heavy jobs.
GITHUB_REPO=
# Key of the render callback signature, the same value in the Worker and in GitHub secrets.
RENDER_CALLBACK_SECRET=
# Absolute URL of POST /api/hooks/render/callback on the Worker that holds the database.
RENDER_CALLBACK_URL=
# Meta app id, set once the Meta app exists (B10).
META_APP_ID=
# Meta app secret: the job runner's daily token check signs debug_token with id|secret (B8 step 8a).
META_APP_SECRET=
# The Page token while Vault's meta_page_token is empty; the token check reads Vault first.
META_PAGE_TOKEN=
# Optional: the headless Claude CLI the caption runner calls on the laptop (B9, ruling H34 (3)); the default is `claude`.
CAPTIONS_CLI=
