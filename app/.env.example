# Public build-time settings. Everything in this first block ships to the browser; never put secrets in VITE_* variables.
# Server names further down are read by Wrangler and Nitro, never by Vite.

# Absolute origin of the deployed site, used for canonical URLs and structured data.
VITE_SITE_URL=https://matterofplace.com

# Base URL of the Matter of Place API. Leave unset to run from bundled content with local, non-persistent forms.
# VITE_API_BASE_URL=https://matterofplace.com/api

# Public Cloudflare Turnstile site key (public by design; the secret key never leaves the server).
VITE_TURNSTILE_SITE_KEY=

# Public Instagram profile. The footer link appears only when this is set.
# VITE_INSTAGRAM_URL=https://www.instagram.com/matterofplace

# Database tools on the laptop (bun run db:psql, bun run db:reset). Server side only: names, never values here.
# Session pooler URL of mop-dev, password percent-encoded:
# postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DEV_DB_URL=
DEV_SUPABASE_PROJECT_REF=
DEV_SUPABASE_DB_PASSWORD=
DEV_SUPABASE_SERVICE_ROLE_KEY=

# Worker settings. Server side only: names, never values here. Locally they go in app/.dev.vars (git-ignored); deployed,
# the deploy jobs and wrangler.toml set them (docs/runbooks/delivery.md).
# local, preview or production: decides which content and which indexing rules apply.
MOP_ENV=
# Absolute base of the public media bucket, the Worker's own origin plus /media.
MEDIA_PUBLIC_BASE=
# Sentry client key of the Worker (a Worker secret). Leave empty to send nothing.
SENTRY_DSN=
# Bearer for POST /api/hooks/sentry-test (a Worker secret). Leave empty and the route answers 404.
SENTRY_TEST_TOKEN=
# Commit SHA of the deploy, set by the deploy jobs with --var; reads as dev when unset.
SENTRY_RELEASE=
