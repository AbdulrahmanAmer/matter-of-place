[
  {
    "id": "f4-a-no-verify",
    "test": "tests/unit/pg-connect.test.ts",
    "file": "scripts/lib/pg-connect.mjs",
    "find": "ssl: { rejectUnauthorized: true, ca: SUPABASE_ROOT_CA_2021 }",
    "replace": "ssl: { rejectUnauthorized: false, ca: SUPABASE_ROOT_CA_2021 }",
    "run": "bunx vitest run --project unit tests/unit/pg-connect.test.ts",
    "expect": "× .*verifies the certificate of a remote host"
  },
  {
