[
  {
    "id": "b5-theme-token-drift",
    "test": "tests/unit/theme.test.ts",
    "file": "src/styles/tokens.css",
    "find": "--accent: #c9c0b2;",
    "replace": "--accent: #c9c0b3;",
    "run": "bunx vitest run --project unit tests/unit/theme.test.ts",
    "expect": "accent equals the --accent token"
  },
  {
    "id": "b5-theme-file-drift",
    "test": "tests/unit/theme.test.ts",
    "file": "src/templates/theme.gen.ts",
    "find": "accent: \"#c9c0b2\",",
    "replace": "accent: \"#c9c0b3\",",
    "run": "bunx vitest run --project unit tests/unit/theme.test.ts",
    "expect": "is exactly what gen-theme writes from tokens.css"
  },
  {
    "id": "b5-theme-rgb",
    "test": "tests/unit/theme.test.ts",
    "file": "src/templates/theme.gen.ts",
    "find": "accent: [0.7882, 0.7529, 0.698],",
    "replace": "accent: [0.7882, 0.7529, 0.7],",
    "run": "bunx vitest run --project unit tests/unit/theme.test.ts",
    "expect": "holds each colour as a 0 to 1 triple of the same bytes"
  },
  {
    "id": "b5-theme-missing-token",
    "test": "tests/unit/theme.test.ts",
    "file": "scripts/gen-theme.ts",
    "find": "if (match?.[1] === undefined) throw new Error(`tokens.css has no six-digit hex for ${token}`);",
    "replace": "if (match?.[1] === undefined) return \"#000000\";",
    "run": "bunx vitest run --project unit tests/unit/theme.test.ts",
    "expect": "refuses a tokens file that lacks a colour"
  },
