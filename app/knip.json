{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "supabase/functions/*/index.ts",
    "tests/**/*.{ts,tsx}",
    "src/domain/index.ts",
    "src/db/index.ts"
  ],
  "ignore": ["src/db/types.ts", "src/domain/enums.check.ts"],
  "ignoreBinaries": ["psql"],
  "ignoreDependencies": ["@fontsource-variable/*", "@react-email/components", "@react-email/render"]
}
