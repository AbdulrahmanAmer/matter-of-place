/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  X-DNS-Prefetch-Control: off
  Reporting-Endpoints: csp="/api/public/csp-report"

/media/*
  Cache-Control: public, max-age=604800

# The email images are shown inside other sites (webmail): the site-wide same-site rule is removed and replaced here.
/email/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=604800

# The brand fonts load inside mail apps (Apple Mail) from other origins: cross-origin, with CORS for @font-face.
/fonts/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache
