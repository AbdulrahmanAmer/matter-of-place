{
  "permissions": {
    "allow": ["Read(./**)", "Edit(./**)"],
    "deny": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Edit(./**/.claude/**)",
      "Edit(./**/CLAUDE.md)",
      "Edit(./**/CLAUDE.local.md)",
      "Edit(./**/.mcp.json)",
      "Read(./**/.env*)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.supabase/**)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/**)",
      "Read(~/AppData/**)",
      "Read(~/.mop-workforce/matter/**)",
      "Read(~/.mop-workforce/live/**)",
      "Read(~/.mop-workforce/runner-app/**)"
    ]
  }
}
