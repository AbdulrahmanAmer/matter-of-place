{
  "permissions": {
    "allow": ["Read", "Grep", "Glob", "WebSearch"],
    "deny": [
      "Bash",
      "Write",
      "Edit",
      "NotebookEdit",
      "WebFetch",
      "Read(~/.claude/**)",
      "Read(~/.config/**)",
      "Read(~/.wrangler/**)",
      "Read(~/.supabase/**)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/AppData/**)",
      "Read(**/creds/**)",
      "Read(**/cloudflare tokens and secrets.txt)",
      "Read(**/Claude Session.txt)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
